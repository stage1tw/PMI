# .streamlit/secrets.toml 로 복사 후 값 입력 (Git에 커밋 금지)
# Streamlit Community Cloud: App settings → Secrets 에 같은 내용 붙여넣기
ANTHROPIC_API_KEY = "sk-ant-..."
ECOS_API_KEY = ""        # https://ecos.bok.or.kr/api/ 에서 무료 발급
DATA_GO_KR_KEY = ""      # https://www.data.go.kr → '조달청_나라장터 입찰공고정보서비스' 활용신청
OPENAI_API_KEY = "sk-..."   # AI 챗봇
# OPENAI_MODEL = "gpt-5.5"  # 선택, 기본값 gpt-5.5
